{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32H723xx",
                "ARM_MATH_CM7",
                "DISABLE_LOG_SYSTEM",
                "USE_PWR_LDO_SUPPLY",
                "_DEBUG"
            ],
            "cStandard": "c17",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-arm",
            "compilerPath": "arm-none-eabi-gcc"
        }
    ],
    "version": 4
}
